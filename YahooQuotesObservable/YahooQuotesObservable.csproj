<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<Authors>DavidS</Authors>
	<Version>0.3.3</Version>
	<AssemblyVersion>0.3.3</AssemblyVersion>
	<FileVersion>0.3.3</FileVersion>
    <PackageId>YahooQuotesObservable</PackageId>
	<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	<PackageIcon>worm64.png</PackageIcon>
	<PackageProjectUrl>https://github.com/dshe/YahooQuotesObservable</PackageProjectUrl>
	<RepositoryUrl>https://github.com/dshe/YahooQuotesObservable</RepositoryUrl>
	<RepositoryType>github</RepositoryType>
	<PackageTags>yahoo finance quotes streaming websocket observable</PackageTags>
	<Description>Streaming quotes from Yahooo Finance.</Description>
	<DebugType>embedded</DebugType>
	<DebugSymbols>true</DebugSymbols>
	<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
	<AnalysisMode>All</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="Utilities\data.proto">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </AdditionalFiles>
	<None Remove="data.proto" />
	<None Include="worm64.png" Pack="true" PackagePath="\" />	  
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
	<PackageReference Include="NodaTime" Version="3.3.4" />
	<PackageReference Include="System.Reactive" Version="7.0.0" />
	<PackageReference Include="protobuf-net" Version="3.4.30" />
  </ItemGroup>

</Project>
